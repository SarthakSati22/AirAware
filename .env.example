# AirAware Environment Configuration Template
# Duplicate this file to .env and adjust variables as required

# Application Settings
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Set your MongoDB Atlas connection string below.
# If left empty, AirAware gracefully runs in offline in-memory mock mode with all 21,900 sample records.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=airaware_db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
